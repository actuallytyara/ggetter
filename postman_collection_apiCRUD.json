        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"inactive\"\n}"
        }
      }
    },
    {
      "name": "DELETE Habit",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/habits/{{habitId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "habits", "{{habitId}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "taskId", "value": "1" },
    { "key": "goalId", "value": "1" },
    { "key": "habitId", "value": "1" }
  ]
}

